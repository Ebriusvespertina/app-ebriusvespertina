---
import { Icon } from 'astro-icon/components';
export interface Props {
	badge?: string;
	title: string;
	description: string;
}

const { badge = 'App.website', title, description } = Astro.props;
---

<section class="hero">
	<div class="badge"><Icon name="lucide:sparkles" width={14} height={14} /> {badge}</div>
	<h1>{title}</h1>
	<p>{description}</p>
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		padding: 1.2rem;
		border: 1px solid rgba(148, 163, 184, 0.18);
		border-radius: 1.25rem;
		background:
			radial-gradient(circle at top right, rgba(96, 165, 250, 0.25), transparent 38%),
			radial-gradient(circle at bottom left, rgba(16, 185, 129, 0.18), transparent 36%),
			rgba(15, 23, 42, 0.8);
		box-shadow: 0 16px 50px rgba(2, 6, 23, 0.4);
	}

	.hero::before,
	.hero::after {
		content: '';
		position: absolute;
		inset: auto;
		border-radius: 999px;
		pointer-events: none;
	}

	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.35rem 0.7rem;
		border-radius: 999px;
		font-size: 0.74rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #cbd5e1;
		background: rgba(15, 23, 42, 0.8);
		border: 1px solid rgba(148, 163, 184, 0.18);
	}

	.hero::before {
		top: -2.5rem;
		right: -2rem;
		width: 8rem;
		height: 8rem;
		background: rgba(59, 130, 246, 0.18);
		filter: blur(8px);
	}

	.hero::after {
		left: 1rem;
		bottom: -2.4rem;
		width: 7rem;
		height: 7rem;
		background: rgba(52, 211, 153, 0.14);
		filter: blur(10px);
	}

	h1 {
		margin: 0.8rem 0 0;
		font-size: clamp(2rem, 8vw, 3.35rem);
		line-height: 1.02;
		letter-spacing: -0.04em;
	}

	p {
		position: relative;
		z-index: 1;
		margin: 0.85rem 0 0;
		font-size: 0.98rem;
		line-height: 1.6;
		color: #cbd5e1;
	}

	@media (min-width: 48rem) {
		.hero {
			padding: 1.5rem;
		}
	}
</style>