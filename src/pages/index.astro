---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppGrid from '../components/AppGrid.astro';
import AppHubHero from '../components/AppHubHero.astro';
import { apps } from '../data/apps';
---

<BaseLayout
	title="D.E.V. Apps"
	description="Een startpagina voor drankspellen en andere apps van Dispuut Ebrius Vespertina."
	appleTitle="D.E.V. Apps"
	background="radial-gradient(circle at top left, rgba(59, 130, 246, 0.16), transparent 30%), radial-gradient(circle at 85% 0%, rgba(16, 185, 129, 0.12), transparent 26%), linear-gradient(180deg, #0f172a 0%, #020617 100%)"
>
	<main>
		<AppHubHero
			badge="App.website"
			title="Dispuut Apps"
			description="Een startpagina voor drankspellen en andere apps van Dispuut Ebrius Vespertina."
		/>

		<AppGrid
			apps={apps}
			title="Beschikbare apps"
			subtitle="Wil je zelf een app? Maak die dan zelf!"
		/>
	</main>
</BaseLayout>

<style>
	main {
		max-width: 72rem;
		margin: 0 auto;
		padding: 1rem;
		display: grid;
		gap: 1rem;
		align-content: start;
		min-height: 100dvh;
	}

	@media (min-width: 48rem) {
		main {
			padding: 1.5rem;
			gap: 1.25rem;
		}
	}
</style>
