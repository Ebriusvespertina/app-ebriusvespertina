---
import WheelPage from '../../components/apps/radje-draaien/WheelPage.vue';
---

<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Radje Draaien</title>
    <style>
      @import '../../styles/tokens.css';

      :root {
        color-scheme: dark;
        font-family: var(--font-family-base);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100dvh;
        background:
          radial-gradient(circle at top, rgba(56, 189, 248, 0.18), transparent 35%),
          linear-gradient(180deg, #0f172a 0%, #020617 100%);
        color: #e2e8f0;
      }
    </style>
  </head>
  <body>
    <WheelPage client:only="vue" />
  </body>
</html>
