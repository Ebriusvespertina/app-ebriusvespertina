---
import DicePage from "../../components/apps/dobbelstenen/DicePage.vue";
import PwaRegister from "../../components/PwaRegister.astro";
---

<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="description" content="Gooi de stenen, vergrendel wat je wilt houden en gooi de rest opnieuw. Doel: boven de 30." />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Dobbelstenen" />
    <title>Dobbelstenen</title>
    <style is:global>
      @import '../../styles/tokens.css';

      :root {
        color-scheme: dark;
        font-family: var(--font-family-base);
      }

      body {
        margin: 0;
        min-height: 100dvh;
        background:
          radial-gradient(circle at top left, rgba(16, 185, 129, 0.16), transparent 30%),
          radial-gradient(circle at 85% 0%, rgba(59, 130, 246, 0.14), transparent 28%),
          linear-gradient(180deg, #0f172a 0%, #020617 100%);
        color: #e2e8f0;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        padding:
          env(safe-area-inset-top, 0)
          env(safe-area-inset-right, 0)
          env(safe-area-inset-bottom, 0)
          env(safe-area-inset-left, 0);
      }
    </style>
  </head>
  <body>
    <DicePage client:only="vue" />
    <PwaRegister />
  </body>
</html>
