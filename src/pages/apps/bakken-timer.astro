	background="radial-gradient(circle at top left, rgba(245, 158, 11, 0.16), transparent 30%), radial-gradient(circle at 85% 0%, rgba(251, 191, 36, 0.1), transparent 26%), linear-gradient(180deg, #0f172a 0%, #020617 100%)"
>
	<TimerPage client:only="vue" />
</BaseLayout>
