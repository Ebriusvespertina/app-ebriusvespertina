---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TimerPage from '../../components/apps/bakken-timer/TimerPage.vue';
---

<BaseLayout
	title="Bakken Timer"
	description="Meet hoe snel jij een bak trekt: houd vast om te starten, laat los zodra je drinkt en tik weer als de bak leeg is."
